# Copy this file to .env and fill it in.

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > your application > General Information > Application ID
CLIENT_ID=
# Optional: your server's ID. Commands then appear instantly there (global commands can
# take up to an hour the first time). Right-click the server icon > Copy Server ID.
GUILD_ID=

# Where the bot streams from: the Simple Player server's mobile API port.
# Same PC as the server: http://127.0.0.1:55555 ; another PC on the LAN: its LAN address.
SP_SERVER=http://127.0.0.1:55555
# The public https address (share links people paste, covers in Discord embeds).
# Empty = ask the server (/api/config publicOrigin).
SP_PUBLIC=

# Optional: path to ffmpeg if it is not on PATH
FFMPEG=
# Optional: path to yt-dlp if it is not on PATH (YouTube, SoundCloud, bilibili…, and
# finding Spotify / Apple Music / Deezer songs on YouTube Music)
YTDLP=
# Optional: a cookies.txt (Netscape format) for age-restricted or members-only videos
YTDLP_COOKIES=
# Optional: extra yt-dlp arguments, separated by spaces
YTDLP_ARGS=
# Most songs taken from one playlist / album link
MAX_PLAYLIST=200

# Start volume in percent (0-150)
DEFAULT_VOLUME=60
# Leave the voice channel after this many seconds with nothing playing / nobody listening
IDLE_SECONDS=180
