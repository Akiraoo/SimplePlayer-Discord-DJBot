{
  "name": "simpleplayer-discord-bot",
  "version": "0.1.0",
  "description": "Discord music bot for Simple Player: plays share links (/s/, /p/, /c/), library search and direct audio URLs in voice channels.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "register": "node --env-file=.env src/register.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.22.0",
    "opusscript": "^0.1.1"
  },
  "license": "Apache-2.0"
}
